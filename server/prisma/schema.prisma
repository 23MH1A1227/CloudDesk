// CloudDesk - Prisma schema
// Datasource: PostgreSQL (local Docker in dev, AWS RDS in production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  CUSTOMER
  SUPPORT_AGENT
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  FRUSTRATED
}

enum NotificationType {
  TICKET_CREATED
  TICKET_ASSIGNED
  TICKET_REPLIED
  TICKET_STATUS_CHANGED
  AI_ANALYSIS_COMPLETED
  SYSTEM
}

enum AuditAction {
  USER_LOGIN
  USER_REGISTERED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  TICKET_CREATED
  TICKET_UPDATED
  TICKET_DELETED
  TICKET_ASSIGNED
  TICKET_STATUS_CHANGED
  TICKET_MESSAGE_SENT
  ATTACHMENT_UPLOADED
  AI_ANALYSIS_REQUESTED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
}

enum AnalysisSource {
  GEMINI
  FALLBACK
}

// ---------------------------------------------------------------- models

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CUSTOMER)
  avatarUrl String?
  isActive  Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets         Ticket[]        @relation("TicketCustomer")
  assignedTickets Ticket[]        @relation("TicketAssignee")
  messages        TicketMessage[]
  attachments     Attachment[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String   @default("#6366f1")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets Ticket[]

  @@index([isActive])
  @@map("categories")
}

model Ticket {
  id             String       @id @default(uuid())
  reference      String       @unique
  title          String
  description    String
  status         TicketStatus @default(OPEN)
  priority       Priority     @default(MEDIUM)
  customerId     String
  assigneeId     String?
  categoryId     String?
  firstResponseAt DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  satisfaction   Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  customer    User            @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  assignee    User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  messages    TicketMessage[]
  attachments Attachment[]
  aiAnalyses  AIAnalysis[]

  @@index([status])
  @@index([priority])
  @@index([customerId])
  @@index([assigneeId])
  @@index([categoryId])
  @@index([createdAt])
  @@map("tickets")
}

model TicketMessage {
  id         String   @id @default(uuid())
  ticketId   String
  authorId   String
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model Attachment {
  id           String   @id @default(uuid())
  ticketId     String
  uploadedById String
  fileName     String
  originalName String
  mimeType     String
  size         Int
  storage      String   @default("local")
  url          String
  createdAt    DateTime @default(now())

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("attachments")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String      @id @default(uuid())
  action    AuditAction
  actorId   String?
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AIAnalysis {
  id                 String         @id @default(uuid())
  ticketId           String
  summary            String
  category           String
  priority           Priority
  sentiment          Sentiment
  missingInformation String[]
  suggestedResponse  String
  recommendedAction  String
  source             AnalysisSource @default(FALLBACK)
  model              String?
  available          Boolean        @default(true)
  error              String?
  createdAt          DateTime       @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ai_analyses")
}
