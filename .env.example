# ============================================================
# CloudDesk - root example environment file
# Copy to server/.env (backend) and client/.env (frontend).
# NEVER commit a real .env file.
# ============================================================

# ---------- Server ----------
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ---------- Database (PostgreSQL) ----------
# Local Docker default (see docker-compose.yml)
DATABASE_URL=postgresql://clouddesk:clouddesk@localhost:5432/clouddesk?schema=public

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---------- AI (Google Gemini) - OPTIONAL ----------
# Leave GEMINI_API_KEY empty to run with the deterministic fallback analyzer.
GEMINI_API_KEY=YOUR_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=20000

# ---------- File storage ----------
# STORAGE_DRIVER=local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ---------- AWS (OPTIONAL - only needed when STORAGE_DRIVER=s3) ----------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---------- Logging ----------
LOG_LEVEL=info

# ---------- Client (Vite) ----------
VITE_API_BASE_URL=http://localhost:5000/api
